<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-create-preferences" author="sysmap">
        <createTable tableName="preferences">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_preferences_user_id"
                             references="users(id)"/>
            </column>
            <column name="type_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_preferences_type_id"
                             references="activity_types(id)"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="preferences"
                columnNames="user_id, type_id"
                constraintName="uq_preferences_user_type"/>
    </changeSet>

</databaseChangeLog>
