<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-create-activity-participants" author="sysmap">
        <createTable tableName="activity_participants">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="activity_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_participant_activity"
                             references="activities(id)"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_participant_user"
                             references="users(id)"/>
            </column>
            <column name="approved" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="confirmed_at" type="TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint tableName="activity_participants"
                             columnNames="activity_id, user_id"
                             constraintName="uq_participant_activity_user"/>
    </changeSet>

</databaseChangeLog>
